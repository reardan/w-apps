#!/usr/bin/env bash
set -euo pipefail
win_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(dirname -- "$win_root")"
w_root="$repo_root/w"
action="${1:-build}"
if (($#)); then shift; fi
if [[ ! -x "$w_root/wbuild" ]]; then
  echo 'Initialize W first: git submodule update --init --recursive' >&2
  exit 1
fi
case "$action" in
  build|run|check|test) ;;
  *) echo 'Usage: win/build [build|run|check|test] [browser arguments]' >&2; exit 2 ;;
esac
(cd "$w_root" && ./wbuild build)
mkdir -p "$win_root/bin"
compiler=("$w_root/bin/wv2" x64)
imports=(--import-root "$win_root/src" --import-root "$w_root")
"${compiler[@]}" check --json "${imports[@]}" "$win_root/main.w"
if [[ "$action" == check ]]; then exit 0; fi
"${compiler[@]}" --strict "${imports[@]}" "$win_root/main.w" -o "$win_root/bin/win"
if [[ "$action" == run ]]; then
  exec "$win_root/bin/win" --home "$win_root/fixtures/start.html" "$@"
fi
if [[ "$action" == test ]]; then
  "${compiler[@]}" check --json "${imports[@]}" "$win_root/tests/browser_test.w"
  "${compiler[@]}" --strict "${imports[@]}" "$win_root/tests/browser_test.w" -o "$win_root/bin/browser_test"
  "$win_root/bin/browser_test" "$win_root/bin/win" "$win_root/fixtures/start.html"
  python3 "$win_root/tests/integration.py" "$win_root/bin/win" "$win_root/fixtures/start.html"
fi
