#!/usr/bin/env bash
set -euo pipefail
win_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(dirname -- "$win_root")"
w_root="$repo_root/w"
action="${1:-build}"
if (($#)); then shift; fi
if [[ ! -x "$w_root/wbuild" ]]; then
  echo 'Initialize W first: git submodule update --init --recursive' >&2
  exit 1
fi
case "$action" in
  build|run|check|test|standards) ;;
  *) echo 'Usage: win/build [build|run|check|test|standards] [browser arguments]' >&2; exit 2 ;;
esac
(cd "$w_root" && ./wbuild build javascript_parser)
mkdir -p "$win_root/bin"
compiler=("$w_root/bin/wv2" x64)
imports=(--import-root "$win_root/src" --import-root "$w_root")
"${compiler[@]}" check --json "${imports[@]}" "$win_root/main.w"
if [[ "$action" == check ]]; then exit 0; fi
"${compiler[@]}" --strict "${imports[@]}" "$win_root/main.w" -o "$win_root/bin/win"
if [[ "$action" == run ]]; then
  exec "$win_root/bin/win" --home "$win_root/fixtures/start.html" "$@"
fi
if [[ "$action" == test ]]; then
  for source in "$win_root"/tests/*_test.w; do
    name="$(basename "$source" .w)"
    "${compiler[@]}" check --json "${imports[@]}" "$source"
    "${compiler[@]}" --strict "${imports[@]}" "$source" -o "$win_root/bin/$name"
    "$win_root/bin/$name" "$win_root/bin/win" "$win_root/fixtures/start.html"
  done
  python3 "$win_root/tests/wpt_runner_test.py"
  for test in "$win_root"/tests/*integration.py; do
    python3 "$test" "$win_root/bin/win" "$win_root/fixtures/start.html"
  done
fi

if [[ "$action" == standards ]]; then
  (cd "$w_root" && ./wbuild javascript_test262)
  python3 "$win_root/tests/wpt_runner_test.py"
  display=()
  if [[ -z "${DISPLAY:-}" ]]; then
    if command -v xvfb-run >/dev/null 2>&1; then
      display=(xvfb-run -a)
    else
      echo 'Native WPT rendering requires X11/OpenGL or xvfb-run.' >&2
      exit 1
    fi
  fi
  "${display[@]}" python3 "$win_root/tests/wpt_capture_test.py" "$win_root/bin/win"
  "${display[@]}" python3 "$win_root/tests/wpt_reftests.py"
fi
