import lib.assert
import win.script

int script_eval(win_script* script, char* text):
	int result = win_script_eval(script, text, strlen(text))
	if (result == 0): print(script.error)
	return result

html_node* script_node(win_script* script, char* id):
	list[html_node*] found = new list[html_node*]
	win_dom_query(script, script.page.html.root, id, 1, found)
	html_node* result = 0
	if (found.length > 0): result = found[0]
	__w_list_free(cast(__w_list*, found))
	return result

void script_selector_tests():
	char* html = c"<main id='outer' class='pick'><section id='near' class='pick'><p id='one' class='item'></p><span></span><p id='two' class='item'></p><p id='three' class='item' hidden></p></section></main>"
	win_page* page = win_page_parse(html, strlen(html))
	win_script* script = win_script_new(page)
	asserts(c"selector API setup", script_eval(script, c"const outer=document.getElementById('outer'); const near=document.getElementById('near'); const one=document.getElementById('one'); const two=document.getElementById('two'); const three=document.getElementById('three');"))
	asserts(c"matches uses shared selectors", script_eval(script, c"if(!two.matches(':nth-child(2 of .item)') || two.matches(':nth-child(2)')) throw 'matches'; if(!two.matches(':is(:unsupported, .item)')) throw 'recovery'; if(two.matches(':is(:unsupported)')) throw 'empty';"))
	asserts(c"closest is inclusive and returns nearest stable wrapper", script_eval(script, c"if(two.closest('.item')!==two || two.closest('.pick')!==near || two.closest('main')!==outer || two.closest('.absent')!==null) throw 'closest';"))
	asserts(c"filtered query order and identity", script_eval(script, c"const items=document.querySelectorAll(':nth-child(odd of .item)'); if(items.length!==2 || items[0]!==one || items[1]!==three) throw 'order'; if(near.querySelector(':nth-last-child(2 of .item)')!==two) throw 'reverse'; if(near.querySelector('.pick')!==null) throw 'descendants only';"))
	asserts(c"invalid selector APIs throw named syntax errors", script_eval(script, c"let errors=0; try {two.matches('p, :unknown');} catch(e) {if(e.name==='SyntaxError') errors+=1;} try {two.closest(':not(:unknown)');} catch(e) {if(e.name==='SyntaxError') errors+=1;} try {document.querySelector('.item,');} catch(e) {if(e.name==='SyntaxError') errors+=1;} try {document.querySelectorAll(':nth-child(2 of .item,:unknown)');} catch(e) {if(e.name==='SyntaxError') errors+=1;} if(errors!==4) throw errors; if(document.querySelector(':is()')!==null || document.querySelectorAll(':where(:unknown)').length!==0) throw 'empty recovery';"))
	asserts(c"mutation synchronizes before matching and collections are static", script_eval(script, c"two.className='changed'; if(two.matches('.item') || document.querySelector(':nth-child(2 of .item)')!==three || items.length!==2) throw 'mutation'; near.remove(); if(two.closest('.pick')!==near || two.closest('main')!==null) throw 'detached ancestry'; if(near.closest('.pick')!==near || !near.matches(':nth-child(1 of .pick)')) throw 'detached self';"))
	asserts(c"empty tree still validates selectors", script_eval(script, c"const detached=document.createElement('div'); let caught=false; try {detached.querySelector('');} catch(e) {caught=e.name==='SyntaxError';} if(!caught || detached.closest('div')!==detached || !detached.matches('div')) throw 'detached';"))
	assert_equal(0, script.failures)
	string_builder* expensive = string_from(c"try {three.matches('")
	for i in range(40): string_append(expensive, c":nth-child(n of ")
	string_append(expensive, c".item")
	for i in range(40): string_append_char(expensive, ')')
	string_append(expensive, c"');} catch(e) {} document.title='escaped';")
	int budget_result = win_script_eval(script, expensive.data, expensive.length)
	asserts(c"nested selector budget is terminal even inside try", budget_result == 0 && script.runtime.completion.status == 5)
	asserts(c"selector budget restored after terminal failure", win_selector_budget == 0 && script_eval(script, c"if(!one.matches('.item')) throw 'recovery';"))
	string_free(expensive)
	win_script_free(script)
	win_page_free(page)

void script_event_tests():
	char* html = c"<div id='outer'><button id='inner'>Go</button></div>"
	win_page* page = win_page_parse(html, strlen(html))
	win_script* script = win_script_new(page)
	html_node* inner = script_node(script, c"inner")
	asserts(c"event phase setup", script_eval(script, c"const outer=document.getElementById('outer'); const inner=document.getElementById('inner'); let order=''; let saved=null; document.addEventListener('phases',function(e){order+='D'; if(e.eventPhase!==1) throw 'phase';},true); outer.addEventListener('phases',function(e){order+='P'; if(e.eventPhase!==1) throw 'phase';},{capture:true}); inner.addEventListener('phases',function(e){order+='T'; if(e.eventPhase!==2) throw 'phase';},true); inner.addEventListener('phases',function(e){order+='t'; if(e.eventPhase!==2) throw 'phase'; saved=e; if(e.target!==inner || e.currentTarget!==inner || !e.bubbles || e.cancelable) throw 'target';}); outer.addEventListener('phases',function(e){order+='p'; if(e.eventPhase!==3) throw 'phase';}); document.addEventListener('phases',function(e){order+='d'; if(e.eventPhase!==3) throw 'phase';});"))
	assert_equal(1, win_script_dispatch(script, inner, c"phases"))
	asserts(c"capture target bubble phases and completed event", script_eval(script, c"if(order!=='DPTtpd') throw order; if(saved.currentTarget!==null || saved.eventPhase!==0) throw 'completed';"))
	asserts(c"listener options identity", script_eval(script, c"let hits=0; function hit(e){hits+=1;} inner.addEventListener('options',hit,{capture:true,once:true}); inner.addEventListener('options',hit,true); inner.addEventListener('options',hit,false); inner.removeEventListener('options',hit,{capture:false});"))
	win_script_dispatch(script, inner, c"options")
	win_script_dispatch(script, inner, c"options")
	asserts(c"once and capture-sensitive removal", script_eval(script, c"if(hits!==1) throw hits;"))
	asserts(c"stop propagation setup", script_eval(script, c"order=''; inner.addEventListener('stop',function(e){order+='a'; e.stopPropagation();}); inner.addEventListener('stop',function(e){order+='b';}); inner.onstop=function(e){order+='i';}; outer.addEventListener('stop',function(e){order+='p';});"))
	win_script_dispatch(script, inner, c"stop")
	asserts(c"stop keeps same-node listeners and inline handler", script_eval(script, c"if(order!=='abi') throw order; order=''; inner.addEventListener('immediate',function(e){order+='a'; e.stopImmediatePropagation();}); inner.addEventListener('immediate',function(e){order+='b';}); inner.onimmediate=function(e){order+='i';}; outer.addEventListener('immediate',function(e){order+='p';});"))
	win_script_dispatch(script, inner, c"immediate")
	asserts(c"immediate stops same-node callbacks", script_eval(script, c"if(order!=='a') throw order;"))
	asserts(c"ancestor capture stop setup", script_eval(script, c"order=''; outer.addEventListener('capturestop',function(e){order+='a'; e.stopPropagation();},true); outer.addEventListener('capturestop',function(e){order+='b';},true); inner.addEventListener('capturestop',function(e){order+='t';});"))
	win_script_dispatch(script, inner, c"capturestop")
	asserts(c"ancestor stop does not reach target", script_eval(script, c"if(order!=='ab') throw order;"))
	asserts(c"passive listener setup", script_eval(script, c"inner.addEventListener('click',function(e){saved=e; e.preventDefault(); if(e.defaultPrevented || !e.cancelable) throw 'passive';},{passive:true,once:true});"))
	assert_equal(1, win_script_dispatch(script, inner, c"click"))
	asserts(c"old event method setup", script_eval(script, c"inner.addEventListener('click',function(e){saved.preventDefault(); saved.stopImmediatePropagation();},{once:true}); inner.addEventListener('click',function(e){order='new';},{once:true});"))
	assert_equal(1, win_script_dispatch(script, inner, c"click"))
	asserts(c"retained event cannot affect another dispatch", script_eval(script, c"if(order!=='new') throw order; inner.addEventListener('click',function(e){e.preventDefault(); saved=e;},{once:true});"))
	assert_equal(0, win_script_dispatch(script, inner, c"click"))
	asserts(c"cancelation retained after dispatch", script_eval(script, c"if(!saved.defaultPrevented) throw 'cancelation'; inner.addEventListener('change',function(e){e.preventDefault(); if(e.cancelable || e.defaultPrevented) throw 'change';});"))
	assert_equal(1, win_script_dispatch(script, inner, c"change"))
	asserts(c"load propagation setup", script_eval(script, c"order=''; document.addEventListener('load',function(e){order+='d';},true); inner.addEventListener('load',function(e){order+='t'; if(e.bubbles || e.cancelable) throw 'load';}); outer.addEventListener('load',function(e){order+='p';});"))
	assert_equal(1, win_script_dispatch(script, inner, c"load"))
	asserts(c"load captures without bubbling", script_eval(script, c"if(order!=='dt') throw order;"))
	asserts(c"listener mutation setup", script_eval(script, c"order=''; function late(e){order+='l';} function removed(e){order+='r';} function ancestor(e){order+='p';} inner.addEventListener('mutation',function(e){order+='a'; inner.addEventListener('mutation',late); inner.removeEventListener('mutation',removed); outer.addEventListener('mutation',ancestor);}); inner.addEventListener('mutation',removed);"))
	win_script_dispatch(script, inner, c"mutation")
	asserts(c"listener snapshot skips additions and honors removals", script_eval(script, c"if(order!=='ap') throw order; order='';"))
	win_script_dispatch(script, inner, c"mutation")
	asserts(c"later dispatch observes new listener", script_eval(script, c"if(order!=='alp') throw order;"))
	asserts(c"phase mutation setup", script_eval(script, c"order=''; inner.addEventListener('laterphase',function(e){order+='c'; inner.addEventListener('laterphase',function(e){order+='b';});},true);"))
	win_script_dispatch(script, inner, c"laterphase")
	asserts(c"listener added in capture can run in bubble invocation", script_eval(script, c"if(order!=='cb') throw order;"))
	int roots = script.runtime.roots.length
	int listeners = script.listeners.length
	asserts(c"listener removal reclaims registrations", script_eval(script, c"function temporary(e){} for(let i=0;i<1100;i+=1){inner.addEventListener('temporary',temporary); inner.removeEventListener('temporary',temporary);} inner.addEventListener('temporary',temporary,{once:true});"))
	assert_equal(listeners + 1, script.listeners.length)
	assert_equal(roots + 1, script.runtime.roots.length)
	win_script_dispatch(script, inner, c"temporary")
	assert_equal(listeners, script.listeners.length)
	assert_equal(roots, script.runtime.roots.length)
	asserts(c"shared callback root setup", script_eval(script, c"let sharedHits=0; function registerShared(){const callback=function(e){sharedHits+=1;}; inner.addEventListener('shared',callback,{once:true}); outer.addEventListener('shared',callback);} registerShared();"))
	win_script_dispatch(script, inner, c"shared")
	# The next evaluation collects heap values after the once registration vanished.
	asserts(c"shared callback first dispatch", script_eval(script, c"if(sharedHits!==2) throw sharedHits;"))
	win_script_dispatch(script, inner, c"shared")
	asserts(c"remaining registration keeps shared closure rooted", script_eval(script, c"if(sharedHits!==3) throw sharedHits;"))
	asserts(c"frozen propagation path setup", script_eval(script, c"order=''; inner.addEventListener('detach',function(e){order+='t'; inner.remove();}); outer.addEventListener('detach',function(e){order+='p';}); document.addEventListener('detach',function(e){order+='d';});"))
	win_script_dispatch(script, inner, c"detach")
	asserts(c"removal preserves dispatch ancestry", script_eval(script, c"if(order!=='tpd') throw order;"))
	assert_equal(0, script.failures)
	asserts(c"listener exceptions setup", script_eval(script, c"order=''; inner.addEventListener('exception',function(e){throw 'expected';}); inner.addEventListener('exception',function(e){order+='a';});"))
	win_script_dispatch(script, inner, c"exception")
	assert_equal(1, script.failures)
	asserts(c"exceptions do not stop subsequent listeners", script_eval(script, c"if(order!=='a') throw order; inner.addEventListener('exhaust',function(e){while(true){};}); inner.addEventListener('exhaust',function(e){order='unexpected';}); inner.onexhaust=function(e){order='inline';};"))
	win_script_dispatch(script, inner, c"exhaust")
	assert_equal(2, script.failures)
	asserts(c"dispatch stops on heap limit and recovers afterward", script_eval(script, c"if(order!=='a') throw order; inner.addEventListener('steps',function(e){while(true);}); inner.addEventListener('steps',function(e){order='unexpected';});"))
	win_script_dispatch(script, inner, c"steps")
	assert_equal(3, script.failures)
	asserts(c"dispatch shares execution budget", script_eval(script, c"if(order!=='a') throw order;"))
	win_script_free(script)
	win_page_free(page)

void main():
	script_event_tests()
	script_selector_tests()
	char* html = c"<title>Before</title><div id='parent'><p id='message' class='note'>before</p><button id='button'>Go</button><input id='field' value='initial'></div>"
	win_page* page = win_page_parse(html, strlen(html))
	win_script* script = win_script_new(page)
	assert_equal(0, script.failures)
	asserts(c"DOM mutation", script_eval(script, c"const message=document.getElementById('message'); message.textContent='after'; message.className='changed'; document.title='After';"))
	char* text = win_dom_text(script_node(script, c"message"))
	assert_strings_equal(c"after", text)
	free(text)
	assert_strings_equal(c"After", page.title)
	assert_strings_equal(c"changed", win_attr(script_node(script, c"message"), c"class"))
	asserts(c"selectors and wrapper identity", script_eval(script, c"if(document.querySelector('#parent > .changed') !== message) throw 'identity'; if(document.querySelectorAll('input').length !== 1) throw 'query'; message.setAttribute('data-test','yes'); if(message.getAttribute('data-test') !== 'yes') throw 'attribute';"))
	asserts(c"style and classes", script_eval(script, c"message.style.color='red'; message.style.fontSize='24px'; message.classList.add('active'); if(!message.classList.contains('active')) throw 'class add'; message.classList.toggle('active'); if(message.classList.contains('active')) throw 'class toggle';"))
	asserts(c"style attributes applied", ends_with(win_attr(script_node(script, c"message"), c"style"), c"font-size:24px"))
	asserts(c"node insertion", script_eval(script, c"const added=document.createElement('p'); added.id='added'; added.textContent='new node'; document.body.appendChild(added);"))
	asserts(c"inserted discoverable", script_node(script, c"added") != 0)
	asserts(c"event binding", script_eval(script, c"let clicks=0; const button=document.getElementById('button'); button.addEventListener('click',function(event){clicks=clicks+1; message.textContent='clicked'; event.preventDefault();}); document.getElementById('parent').addEventListener('click',function(event){message.setAttribute('data-bubble','yes');});"))
	assert_equal(0, win_script_dispatch(script, script_node(script, c"button"), c"click"))
	text = win_dom_text(script_node(script, c"message"))
	assert_strings_equal(c"clicked", text)
	free(text)
	assert_strings_equal(c"yes", win_attr(script_node(script, c"message"), c"data-bubble"))
	asserts(c"event closure survived collection", script_eval(script, c"if(clicks !== 1) throw 'click count';"))
	win_dom_set_attr(script_node(script, c"field"), c"value", c"typed")
	asserts(c"input handler", script_eval(script, c"document.getElementById('field').addEventListener('input',function(event){message.textContent=event.target.value;});"))
	assert_equal(1, win_script_dispatch(script, script_node(script, c"field"), c"input"))
	text = win_dom_text(script_node(script, c"message"))
	assert_strings_equal(c"typed", text)
	free(text)
	asserts(c"inline handler setup", script_eval(script, c"document.getElementById('field').setAttribute('onchange','document.title=\"Inline\"; return false;'); console.log('recorded');"))
	assert_equal(1, win_script_dispatch(script, script_node(script, c"field"), c"change"))
	assert_strings_equal(c"Inline", page.title)
	assert_equal(1, script.console.length)
	assert_strings_equal(c"recorded", script.console[0])
	asserts(c"ready handler", script_eval(script, c"document.addEventListener('DOMContentLoaded',function(event){document.title='Ready';});"))
	win_script_ready(script)
	assert_strings_equal(c"Ready", page.title)
	asserts(c"execution budget stops loop", win_script_eval(script, c"while(true){}", 13) == 0)
	asserts(c"later scripts survive error", script_eval(script, c"document.title='Recovered';"))
	assert_strings_equal(c"Recovered", page.title)
	script.dom_bytes = 4194304
	asserts(c"DOM allocation budget", win_script_eval(script, c"message.textContent='limited';", 30) == 0)
	win_script_free(script)
	win_page_free(page)
	# Independent page realms never see another tab's lexical bindings.
	page = win_page_parse(c"<p>Second</p>", 13)
	script = win_script_new(page)
	asserts(c"isolated realm", win_script_eval(script, c"clicks;", 7) == 0)
	win_script_free(script)
	win_page_free(page)
	print(c"script tests passed")
