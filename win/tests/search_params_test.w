import lib.assert
import win.script

void search_eval(win_script* script, char* source):
	int ok = win_script_eval(script, source, strlen(source))
	if (ok == 0): println(script.error)
	asserts(c"URLSearchParams semantics", ok)

void search_limit(win_script* script, char* source):
	assert_equal(0, win_script_eval(script, source, strlen(source)))
	assert_equal(5, script.runtime.completion.status)

int main():
	char* html = c"<body></body>"
	win_page* page = win_page_parse(html, strlen(html))
	win_script* script = win_script_new(page)
	search_eval(script, c"const p=new URLSearchParams('?a=1&b=2&a=3&&empty&=blank'); if(p.size!==5||p.get('a')!=='1'||p.get('missing')!==null||p.get('empty')!==''||p.get('')!=='blank') throw 'parse'; const all=p.getAll('a'); if(all.length!==2||all[0]!=='1'||all[1]!=='3'||p.getAll('missing').length!==0) throw 'getAll'; all[0]='other'; if(p.get('a')!=='1') throw 'snapshot';")
	search_eval(script, c"if(!p.has('a')||!p.has('a','3')||p.has('a','4')||!p.has('a',undefined)) throw 'has'; if(p.append('a','4')!==undefined||p.set('a','5')!==undefined||p.toString()!=='a=5&b=2&empty=&=blank') throw 'set'; p.append('a','6'); p.append('a','5'); p.delete('a','5'); if(p.get('a')!=='6'||p.size!==4) throw 'delete value'; p.delete('a',undefined); p.set('z',null); p.append(undefined,false); if(p.toString()!=='b=2&empty=&=blank&z=null&undefined=false') throw 'delete all/coercion';")
	search_eval(script, c"const enc=new URLSearchParams('x=a+b%2Bc&nul=%00&bad=%E2%82A&bad2=%E0%80%80&raw=%GG%2#&eq=a=b'); if(enc.get('x')!=='a b+c'||enc.get('nul')!=='\\u0000'||enc.get('bad')!=='�A'||enc.get('bad2')!=='���'||enc.get('raw')!=='%GG%2#'||enc.get('eq')!=='a=b') throw 'decode'; enc.set('x',' ~!*()-._/😀'); if(enc.get('x')!==' ~!*()-._/😀'||enc.toString().indexOf('x=+%7E%21*%28%29-._%2F%F0%9F%98%80')!==0) throw 'encode'; enc.append('\\uD800','\\uDC00'); if(enc.get('�')!=='�') throw 'USV'; const round=new URLSearchParams(enc.toString()); if(round.toString()!==enc.toString()) throw 'round trip';")
	search_eval(script, c"const sorted=new URLSearchParams('z=1&a=first&z=2&a=second'); sorted.append('\\uE000','p'); sorted.append('😀','s'); if(sorted.sort()!==undefined||sorted.toString()!=='a=first&a=second&z=1&z=2&%F0%9F%98%80=s&%EE%80%80=p') throw 'stable UTF16 sort'; const copy=new URLSearchParams(sorted); sorted.delete('a'); if(copy.getAll('a').length!==2) throw 'copy'; if(String(copy)!==copy.toString()||window.URLSearchParams!==URLSearchParams) throw 'stringifier';")
	search_eval(script, c"const pairs=new URLSearchParams([['x',1],['x',false],['nil',null]]); if(pairs.toString()!=='x=1&x=false&nil=null') throw 'pairs'; const record=new URLSearchParams({z:3,'2':'two','1':'one',a:undefined}); if(record.toString()!=='1=one&2=two&z=3&a=undefined') throw 'record'; if(new URLSearchParams().size!==0||new URLSearchParams(undefined).size!==0||new URLSearchParams(null).toString()!=='null='||new URLSearchParams(true).toString()!=='true=') throw 'defaults';")
	search_eval(script, c"const live=new URLSearchParams('a=1&b=2&c=3'); const owner={trace:''}; live.forEach(function(v,k,obj){if(obj!==live||this!==owner) throw 'callback identity'; this.trace+=k+v; if(k==='a'){obj.delete('b'); obj.append('d','4');} if(k==='c') obj.set('d','5');},owner); if(owner.trace!=='a1c3d5') throw 'live iteration'; let once=0; try{live.forEach(function(){once+=1; throw 'stop';});}catch(e){if(e!=='stop') throw e;} if(once!==1) throw 'exception'; let nested=0; live.forEach(function(){live.forEach(function(){nested+=1;});}); if(nested!==9) throw 'reentrancy';")
	search_eval(script, c"let errors=0; try{URLSearchParams('a=1');}catch(e){errors+=1;} try{p.get();}catch(e){errors+=1;} try{p.append('x');}catch(e){errors+=1;} try{p.set('x');}catch(e){errors+=1;} try{p.forEach(null);}catch(e){errors+=1;} try{new URLSearchParams([['a']]);}catch(e){errors+=1;} try{p.get.call({},'x');}catch(e){errors+=1;} try{URLSearchParams.prototype.toString();}catch(e){errors+=1;} if(errors!==8) throw 'argument/brand checks'; const borrowed=p.get; if(borrowed.call(new URLSearchParams('x=ok'),'x')!=='ok') throw 'borrow';")
	search_eval(script, c"const coercion=new URLSearchParams('a=old'); let order=''; const key={toString:function(){order+='k'; coercion.append('b','side'); return 'a';}}; const value={toString:function(){order+='v'; return 'new';}}; coercion.set(key,value); if(order!=='kv'||coercion.toString()!=='a=new&b=side') throw 'coercion order'; try{coercion.set('a',{toString:function(){throw 'conversion';}});}catch(e){if(e!=='conversion') throw e;} if(coercion.get('a')!=='new') throw 'atomic conversion';")
	js_value* hidden = js_runtime_alloc(script.runtime, 5)
	js_runtime_set(script.runtime, hidden, c"own", win_web_string(script.runtime, c"yes"))
	js_text* skip = js_runtime_key(c"skip")
	js_runtime_define_data(script.runtime, hidden, skip, win_web_string(script.runtime, c"no"), 1, 0, 1)
	js_text_free(skip)
	js_value* inherited = js_runtime_alloc(script.runtime, 5)
	inherited.prototype = hidden
	js_runtime_set(script.runtime, inherited, c"child", win_web_string(script.runtime, c"ok"))
	js_runtime_set(script.runtime, script.runtime.global, c"hidden", hidden)
	js_runtime_set(script.runtime, script.runtime.global, c"inherited", inherited)
	search_eval(script, c"const collisions={}; collisions['\\uD800']='first'; collisions['\\uDC00']='last'; const collapsed=new URLSearchParams(collisions); if(collapsed.size!==1||collapsed.get('�')!=='last') throw 'record USV collision'; const pair=[]; pair.push({toString:function(){pair.push('grown'); return 'key';}}); const grown=new URLSearchParams([pair]); if(grown.toString()!=='key=grown') throw 'live pair length'; if(new URLSearchParams(hidden).toString()!=='own=yes'||new URLSearchParams(inherited).toString()!=='child=ok') throw 'record own enumerable'; if(!(p instanceof URLSearchParams)||!('size' in p)||!('get' in p)) throw 'prototype';")
	search_eval(script, c"const waiting=new URLSearchParams('first=one&second=two'); let resume; let after=''; waiting.forEach(async function(v,k,obj){await new Promise(function(resolve){resume=resolve;}); after+=k+v; obj.append('late','value');}); waiting.delete('second');")
	assert_equal(2, script.runtime.async_tasks.length)
	js_runtime_collect(script.runtime)
	search_eval(script, c"resume();")
	search_eval(script, c"if(after!=='secondtwo'||waiting.get('late')!=='value') throw 'async callback lifetime';")
	assert_equal(1, script.runtime.async_tasks.length)
	win_script_stop(script)
	assert_equal(0, script.runtime.async_tasks.length)
	# Explicit collection between entries must retain native state/prototypes.
	asserts(c"collect idle realm", js_runtime_collect(script.runtime) >= 0)
	search_eval(script, c"if(p.get('b')!=='2'||p.size!==5) throw 'retained state'; p.append('after','gc');")
	assert_equal(0, script.failures)
	search_eval(script, c"const full=new URLSearchParams(); for(let i=0;i<1024;i++) full.append('k','v');")
	search_limit(script, c"full.append('extra','value');")
	search_eval(script, c"if(full.size!==1024) throw 'pair refusal atomic'; full.set('k','one'); if(full.size!==1) throw 'quota recovery';")
	search_eval(script, c"const loop=new URLSearchParams('x=1');")
	asserts(c"lower task budget", win_script_set_execution_budget(script, 3000))
	search_limit(script, c"loop.forEach(function(v,k,q){q.append(k,v);});")
	asserts(c"restore budget", win_script_set_execution_budget(script, WIN_EXECUTION_DEFAULT))
	search_eval(script, c"if(loop.size<2) throw 'callback did not run';")
	# Oversized conversions and serialization preserve the list.
	string_builder* source = string_from(c"const huge='")
	for i in range(65536): string_append_char(source, 'x')
	string_append(source, c"'; const bounded=new URLSearchParams(); bounded.append('',huge);")
	asserts(c"maximum list units", win_script_eval(script, source.data, source.length))
	string_free(source)
	search_limit(script, c"bounded.append('x','');")
	search_limit(script, c"bounded.toString();")
	search_eval(script, c"if(bounded.size!==1||bounded.get('').length!==65536) throw 'unit refusal atomic'; bounded.delete(''); if(bounded.size!==0) throw 'release quota';")
	search_eval(script, c"const reverse=new URLSearchParams(); for(let i=40;i>0;i--) reverse.append('common-prefix-'+i,'v'); const unsorted=reverse.toString();")
	asserts(c"lower sort budget", win_script_set_execution_budget(script, 200))
	search_limit(script, c"reverse.sort();")
	asserts(c"restore sort budget", win_script_set_execution_budget(script, WIN_EXECUTION_DEFAULT))
	search_eval(script, c"if(reverse.toString()!==unsorted) throw 'sort failure changed list';")
	int count = script.search_params.states.length
	int units = script.search_params.units
	search_eval(script, c"try{new URLSearchParams([['ok','first'],['broken']]);}catch(e){}")
	assert_equal(count, script.search_params.states.length)
	assert_equal(units, script.search_params.units)
	win_script_free(script)
	win_page_free(page)
	# Aggregate retained text and object counts have independent realm bounds.
	page = win_page_parse(html, strlen(html))
	script = win_script_new(page)
	source = string_from(c"const huge='")
	for i in range(65536): string_append_char(source, 'x')
	string_append(source, c"'; const retained=[];")
	asserts(c"realm quota setup", win_script_eval(script, source.data, source.length))
	string_free(source)
	for i in range(8): search_eval(script, c"{const next=new URLSearchParams(); next.append('',huge); retained.push(next);}")
	assert_equal(524288, script.search_params.units)
	search_limit(script, c"new URLSearchParams('a=1');")
	assert_equal(8, script.search_params.states.length)
	assert_equal(524288, script.search_params.units)
	search_eval(script, c"retained[0].delete(''); const recovered=new URLSearchParams('a=1'); if(recovered.get('a')!=='1') throw 'realm recovery';")
	search_limit(script, c"for(let i=0;i<256;i++) new URLSearchParams();")
	assert_equal(256, script.search_params.states.length)
	search_eval(script, c"if(retained[1].get('').length!==65536) throw 'realm refusal changed list';")
	win_script_free(script)
	win_page_free(page)
	if (malloc_debug_mode): assert_equal(0, debug_alloc_report_leaks())
	println(c"Win URLSearchParams mutation, encoding, ordering, callbacks and bounds: OK")
	return 0
