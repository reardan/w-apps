import lib.assert
import win.style

html_node* selector_node(html_document* document, char* id):
	html_node* node = document.allocations
	while (node != 0):
		if (node.kind == HTML_START && strcmp(win_attr(node, c"id"), id) == 0): return node
		node = node.allocation_next
	return 0

void selector_expect(html_node* node, char* selector, int expected):
	asserts(selector, win_selector_matches(node, selector) == expected)

void test_attribute_operators():
	char* source = c"<p id='target' data-tags='first Mixed third' lang='en-US' data-path='Prefix-middle.SVG' data-empty='' data-num='12'></p>"
	html_document* document = html_parse(source, strlen(source))
	html_node* node = selector_node(document, c"target")
	selector_expect(node, c"[data-tags]", 1)
	selector_expect(node, c"[DATA-TAGS]", 1)
	selector_expect(node, c"[LANG|=EN i]", 1)
	selector_expect(node, c"[data-tags~='Mixed']", 1)
	selector_expect(node, c"[data-tags~=mixed]", 0)
	selector_expect(node, c"[data-tags~=MIXED i]", 1)
	selector_expect(node, c"[data-tags~=Mixed s]", 1)
	selector_expect(node, c"[data-tags~=mixed s]", 0)
	selector_expect(node, c"[data-tags~=ix]", 0)
	selector_expect(node, c"[data-tags~='first Mixed']", 0)
	selector_expect(node, c"[lang|=en]", 1)
	selector_expect(node, c"[lang|=en-US]", 1)
	selector_expect(node, c"[lang|=e]", 0)
	selector_expect(node, c"[lang|=EN i]", 1)
	selector_expect(node, c"[data-path^=Prefix]", 1)
	selector_expect(node, c"[data-path^=prefix I]", 1)
	selector_expect(node, c"[data-path$='.SVG']", 1)
	selector_expect(node, c"[data-path$='.svg' i]", 1)
	selector_expect(node, c"[data-path*=middle]", 1)
	selector_expect(node, c"[data-path*=MIDDLE i]", 1)
	selector_expect(node, c"[data-path*=absent]", 0)
	selector_expect(node, c"[data-path='prefix-middle.svg' i]", 1)
	selector_expect(node, c"[data-path='prefix-middle.svg' s]", 0)
	selector_expect(node, c"[data-empty='']", 1)
	selector_expect(node, c"[data-tags~='']", 0)
	selector_expect(node, c"[data-path^='']", 0)
	selector_expect(node, c"[data-path$='']", 0)
	selector_expect(node, c"[data-path*='']", 0)
	selector_expect(node, c"[missing*=anything]", 0)
	selector_expect(node, c"[data-num='12']", 1)
	selector_expect(node, c"[data-num=12]", 0)
	selector_expect(node, c"[data-path^ =Prefix]", 0)
	selector_expect(node, c"[lang=en-US x]", 0)
	selector_expect(node, c"[lang i]", 0)
	selector_expect(node, c"[lang=en-US i extra]", 0)
	html_document_free(document)

void test_structural_pseudos():
	char* source = c"<main><p id='one'>text</p>between<!-- comment --><span id='two'></span><p id='three'></p><p id='four'></p><span id='five'></span></main><aside><em id='only'></em></aside>"
	html_document* document = html_parse(source, strlen(source))
	html_node* one = selector_node(document, c"one")
	html_node* two = selector_node(document, c"two")
	html_node* three = selector_node(document, c"three")
	html_node* four = selector_node(document, c"four")
	html_node* five = selector_node(document, c"five")
	html_node* only = selector_node(document, c"only")
	selector_expect(one, c"p:nth-child(2n+1)", 1)
	selector_expect(two, c"span:nth-child(2n+1)", 0)
	selector_expect(three, c"p:nth-child(2n + 1)", 1)
	selector_expect(three, c"p:NTH-CHILD(ODD)", 1)
	selector_expect(two, c"span:nth-child(EVEN)", 1)
	selector_expect(three, c"p:nth-child(+n-2)", 1)
	selector_expect(three, c"p:nth-child(n - 2)", 1)
	selector_expect(three, c"p:nth-child(-n+3)", 1)
	selector_expect(four, c"p:nth-child(-n+3)", 0)
	selector_expect(three, c"p:nth-child(0n+3)", 1)
	selector_expect(three, c"p:nth-child(3)", 1)
	selector_expect(three, c"p:nth-child(+3)", 1)
	selector_expect(three, c"p:nth-child(-3)", 0)
	selector_expect(three, c"p:nth-child(0)", 0)
	selector_expect(three, c"p:nth-child(-2n+5)", 1)
	selector_expect(four, c"p:nth-child(-2n+5)", 0)
	selector_expect(four, c"p:nth-last-child(2)", 1)
	selector_expect(two, c"span:nth-last-child(2n)", 1)
	selector_expect(three, c"p:nth-of-type(2)", 1)
	selector_expect(three, c"p:nth-last-of-type(2)", 1)
	selector_expect(four, c"p:nth-last-of-type(1)", 1)
	selector_expect(one, c":first-child:first-of-type", 1)
	selector_expect(two, c":first-of-type", 1)
	selector_expect(two, c":first-child", 0)
	selector_expect(four, c":last-of-type", 1)
	selector_expect(four, c":last-child", 0)
	selector_expect(five, c":last-child:last-of-type", 1)
	selector_expect(only, c":only-child:only-of-type", 1)
	selector_expect(one, c":only-child", 0)
	selector_expect(two, c":only-of-type", 0)
	selector_expect(three, c"main > p:not(:nth-child(even))", 1)
	selector_expect(three, c"main > :is(p:nth-of-type(2), span)", 1)
	selector_expect(three, c":where(:nth-child(3))", 1)
	selector_expect(three, c":nth-child(2n/**/+/**/1)", 1)
	selector_expect(three, c":nth-child(2 n+1)", 0)
	selector_expect(three, c":nth-child(3garbage)", 0)
	selector_expect(three, c":nth-child(3.5)", 0)
	selector_expect(three, c":nth-child(3e0)", 0)
	selector_expect(three, c":nth-child(n+-1)", 0)
	selector_expect(three, c":nth-child(n 3)", 0)
	selector_expect(three, c":nth-child(999999999999999999999)", 0)
	selector_expect(three, c":nth-child(3 of p)", 0)
	selector_expect(three, c":not(:nth-child(\\33))", 0)
	selector_expect(three, c":not(:nth-child(n\\2b 1))", 0)
	selector_expect(three, c":nth-child(2\\6e +1)", 1)
	selector_expect(three, c":not(:nth-child(3garbage))", 0)
	selector_expect(three, c":not(:nth-child())", 0)
	selector_expect(three, c":not(:nth-child(+))", 0)
	selector_expect(three, c":not(:nth-child(n+))", 0)
	selector_expect(three, c":not(:hover)", 0)
	selector_expect(three, c":not(.missing:hover)", 0)
	selector_expect(three, c":not([missing=12])", 0)
	selector_expect(three, c"p > > p", 0)
	selector_expect(three, c"p*", 0)
	selector_expect(three, c":not()", 0)
	html_document_free(document)

int main():
	test_attribute_operators()
	test_structural_pseudos()
	println(c"Win attribute selectors and structural pseudo-classes: OK")
	return 0
